{
  "name": "kemi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.10 <25"
  },
  "scripts": {
    "build:shared": "npm run build -w @kemi/shared",
    "dev:web": "npm run dev -w @kemi/web",
    "build:web": "npm run build -w @kemi/web",
    "preview:web": "npm run preview -w @kemi/web",
    "lint:web": "npm run lint -w @kemi/web",
    "typecheck:web": "npm run typecheck -w @kemi/web",
    "test:web": "npm run test -w @kemi/web",
    "test:web:e2e": "npm run test:e2e -w @kemi/web",
    "dev:api": "npm run dev -w @kemi/api",
    "build:api": "npm run lint -w @kemi/shared && npm run build -w @kemi/api",
    "test:api": "npm run test -w @kemi/api",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test:api:db": "npm run test:db -w @kemi/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --write apps/web/src/features/portfolio/CatalogLive.tsx && git diff -- apps/web/src/features/portfolio/CatalogLive.tsx && exit 1",
    "dev": "npm run dev:web",
    "build": "npm run build:web",
    "preview": "npm run preview:web",
    "check:tokens": "node KEMI-Design-System/KEMI-Design-System/scripts/verify-design-system.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "3.9.10"
  }
}
