# Vite 개발 서버만 읽는 값. 프론트엔드 번들에는 포함하지 않는다.
API_PROXY_TARGET=http://localhost:4000

# Public browser settings only. Never put credentials in VITE_*.
VITE_ENABLE_MOCKS=false
# Enable existing auth API contract only after Origin/cookie environment setup.
# Signup remains Mock-only until P01/password conflict is resolved.
VITE_ENABLE_AUTH_API=false
# Prefer same-origin /api proxy/rewrite for Secure SameSite=Lax refresh cookies.
VITE_API_BASE_URL=
