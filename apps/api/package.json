{
  "name": "@kemi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm run build -w @kemi/shared",
    "predev": "npm run build -w @kemi/shared",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prelint": "npm run build -w @kemi/shared && prisma generate",
    "lint": "eslint . --max-warnings 0",
    "build": "npm run lint && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run --project unit",
    "pretest:db": "npm run build -w @kemi/shared && prisma generate",
    "test:db": "vitest run --project db",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:watch": "vitest",
    "pretypecheck": "npm run build -w @kemi/shared",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/run.ts",
    "predocs:api": "npm run build -w @kemi/shared",
    "docs:api": "tsx src/docs/write-spec.ts"
  },
  "dependencies": {
    "@kemi/shared": "^0.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.10 <25"
  }
}
