# KEMI API 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# development | test | production
NODE_ENV=development

# Render는 PORT를 자동으로 지정한다. 로컬 기본값은 4000.
PORT=4000

# 실행용 DB 주소 (Supabase 대시보드 > Connect > Session pooler 권장, 아래 README 참고)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 서버 한 대가 여는 최대 DB 연결 수
DATABASE_POOL_MAX=5

# (선택) 마이그레이션 전용 주소. 비워두면 DATABASE_URL을 사용한다.
# MIGRATION_DATABASE_URL=
