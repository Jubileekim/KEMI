# KEMI API 환경 변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# development | test | production
NODE_ENV=development

# Render는 PORT를 자동으로 지정한다. 로컬 기본값은 4000.
PORT=4000

# 실행용 DB 주소 (Supabase 대시보드 > Connect > Session pooler 권장, 아래 README 참고)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 서버 한 대가 여는 최대 DB 연결 수
DATABASE_POOL_MAX=5

# (선택) 마이그레이션 전용 주소. 비워두면 DATABASE_URL을 사용한다.
# MIGRATION_DATABASE_URL=

# Access 토큰 서명 키 (32자 이상). 예: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# 프론트엔드 주소. Refresh 쿠키를 쓰는 요청(refresh·logout)의 Origin과 같아야 한다.
APP_ORIGIN=http://localhost:5173

# 앞단 프록시 개수. 로컬은 0. Render·Vercel 배포 값은 배포 후 확인해서 넣는다(README "클라이언트 IP").
TRUST_PROXY_HOPS=0

# (선택) 소셜 로그인. 비워두면 해당 로그인 버튼은 SOCIAL_UNAVAILABLE로 안내된다.
# 제공자 콘솔에 등록할 콜백 주소: ${APP_ORIGIN}/api/auth/google/callback, ${APP_ORIGIN}/api/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# (선택) 심화 기능 AI 단가 분석: 서버에서만 사용, 키 없으면 503
AI_PRICING_API_KEY=
AI_PRICING_MODEL=gpt-4o-mini
