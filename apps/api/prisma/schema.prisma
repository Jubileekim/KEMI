// KEMI 백엔드 Prisma 스키마
// 테이블은 ERD v0.6과 docs/decisions/2026-10-19-backend-setup.md 결정을 기준으로
// 기능 단위 PR에서 순서대로 추가한다. 변경 명세: docs/erd/erd-v0.6-changes.md
//
// 상태값 규칙: PostgreSQL enum 대신 text + CHECK 제약을 사용하고,
// 허용 값은 @kemi/shared의 Zod enum과 같은 목록으로 관리한다.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── 회원·인증 ────────────────────────────────────────────────
// CHECK 제약(역할·상태·제공자·폐기 사유·이메일 정규화 등)은 마이그레이션 SQL에 직접 작성했다.
// 회원은 삭제하지 않고 상태로 관리하므로 FK는 삭제를 막는다(Restrict).

model User {
  id           BigInt   @id @default(autoincrement())
  // 이메일 로그인 주소. 소셜 전용 가입자는 NULL. 정규화(trim + 소문자)한 값만 저장한다.
  email        String?  @unique
  // bcrypt 해시. 소셜 전용 계정은 NULL이며 이메일·비밀번호 로그인을 할 수 없다.
  passwordHash String?  @map("password_hash")
  name         String   @db.VarChar(20)
  role         String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities       AuthIdentity[]
  sessions         AuthSession[]
  clientProfile    ClientProfile?
  creatorProfile   CreatorProfile?
  projects         Project[]
  clientRequests   WorkRequest[]        @relation("WorkRequestClient")
  creatorRequests  WorkRequest[]        @relation("WorkRequestCreator")
  notifications    Notification[]
  projectBookmarks ProjectBookmark[]
  termsAuthored    TermsVersion[]       @relation("TermsVersionAuthor")
  termsRequested   TermsVersion[]       @relation("TermsVersionSigningRequester")
  signatures       Signature[]
  clientContracts  Contract[]           @relation("ContractClient")
  creatorContracts Contract[]           @relation("ContractCreator")
  payments         Payment[]
  chatMessages     ChatMessage[]
  files            File[]
  materials        ProductionMaterial[]
  deadlineChanges  DeadlineChange[]     @relation("DeadlineChangeRequester")
  deadlineAnswers  DeadlineChange[]     @relation("DeadlineChangeResponder")
  deliverables     Deliverable[]        @relation("DeliverableSubmitter")
  revisionRequests RevisionRequest[]    @relation("RevisionRequester")
  reviewsWritten   Review[]             @relation("ReviewAuthor")
  reviewsReceived  Review[]             @relation("ReviewSubject")
  servicePackages  ServicePackage[]
  portfolios       Portfolio[]
  projectDrafts    ProjectDraft[]
  aiReports        AiReport[]
  chatReads        ChatRead[]

  @@map("users")
}

model AuthIdentity {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  // 제공자가 알려준 이메일(선택). users.email과 자동으로 병합하지 않는다.
  providerEmail  String?  @map("provider_email")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

// 로그인 세션 1건 = Refresh 토큰 계열 1개. id는 Access 토큰의 sid이며 회전해도 바뀌지 않는다.
model AuthSession {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  // 로그인 시각 + 7일. 회전해도 연장하지 않는다.
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens AuthRefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

// 개별 Refresh 토큰. 원문은 저장하지 않고 SHA-256 해시만 둔다. 회전 이력 보존을 위해 삭제하지 않는다.
model AuthRefreshToken {
  id           BigInt    @id @default(autoincrement())
  sessionId    BigInt    @map("session_id")
  tokenHash    String    @unique @map("token_hash")
  // 회전에 사용된 시각. NULL이면 아직 쓸 수 있다.
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById BigInt?   @unique @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session    AuthSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy AuthRefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   AuthRefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@map("auth_refresh_tokens")
}

// ─── 역할별 프로필 ────────────────────────────────────────────
// 회원 1명당 역할에 맞는 프로필 하나. 역할 일치는 서버에서 검사한다.
// 선택값(분야·스타일·역할·공개 상태)의 허용 목록은 마이그레이션 CHECK와 @kemi/shared가 같게 유지한다.

// 의뢰인 프로필 (PROFILE-01). 브랜드 정보는 모두 선택이다. 로고는 파일 기능에서 추가한다.
model ClientProfile {
  userId       BigInt   @id @map("user_id")
  brandName    String?  @map("brand_name")
  introduction String?
  industry     String?
  websiteUrl   String?  @map("website_url")
  socialUrl    String?  @map("social_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("client_profiles")
}

// 크리에이터 프로필 (PROFILE-02). 저장만으로 공개하지 않는다(service_status 기본 DRAFT).
model CreatorProfile {
  userId          BigInt    @id @map("user_id")
  introduction    String?
  niche           String?
  contentStyles   String[]  @default([]) @map("content_styles")
  productionRoles String[]  @default([]) @map("production_roles")
  workMethod      String?   @map("work_method")
  serviceStatus   String    @default("DRAFT") @map("service_status")
  isAvailable     Boolean   @default(false) @map("is_available")
  availableFrom   DateTime? @map("available_from") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("creator_profiles")
}

// ─── 공개 맞춤 의뢰 ───────────────────────────────────────────
// PRD v2.0 PROJ-01·02. 공개 프로젝트는 CLIENT가 만들고 CREATOR가 탐색·지원한다.
// 지원·계약 관계는 후속 work_requests 기능에서 연결한다.

model Project {
  id                      BigInt    @id @default(autoincrement())
  clientId                BigInt    @map("client_id")
  title                   String    @db.VarChar(200)
  description             String
  purpose                 String
  styles                  String[]  @default([])
  budget                  BigInt
  expectedDurationSeconds Int?      @map("expected_duration_seconds")
  recruitmentEndAt        DateTime  @map("recruitment_end_at") @db.Timestamptz(3)
  deliveryDueDate         DateTime  @map("delivery_due_date") @db.Date
  status                  String    @default("OPEN")
  closeReason             String?   @map("close_reason")
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  client        User              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  workRequests  WorkRequest[]
  notifications Notification[]
  bookmarks     ProjectBookmark[]
  contract      Contract?
  draft         ProjectDraft?

  @@index([status, recruitmentEndAt])
  @@index([purpose])
  @@index([budget])
  @@index([createdAt])
  @@map("projects")
}

// 의뢰 요청 (ERD v0.6 work_requests). 페이즈 2는 공개 프로젝트 지원(PROJECT_APPLICATION)만 만든다.
// 직접 의뢰(DIRECT_REQUEST)용 열(brief, response_expires_at, client_request_key 등)은 해당 기능에서 추가한다.
model WorkRequest {
  id              BigInt    @id @default(autoincrement())
  requestType     String    @map("request_type")
  clientId        BigInt    @map("client_id")
  creatorId       BigInt    @map("creator_id")
  projectId       BigInt?   @map("project_id")
  message         String
  initialAmount   BigInt    @map("initial_amount")
  expectedDays    Int       @map("expected_days")
  status          String    @default("PENDING")
  closedReason    String?   @map("closed_reason")
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(3)
  // 직접 의뢰(DIRECT_REQUEST)만: 패키지, 요청 시점 패키지 조건 사본, 목적·행사일, 크리에이터 응답 기한
  packageId       BigInt?   @map("package_id")
  packageSnapshot Json?     @map("package_snapshot")
  purpose         String?
  eventDate       DateTime? @map("event_date") @db.Date
  respondDueAt    DateTime? @map("respond_due_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  servicePackage ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  client         User            @relation("WorkRequestClient", fields: [clientId], references: [id], onDelete: Restrict)
  creator        User            @relation("WorkRequestCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  notifications  Notification[]
  termsVersions  TermsVersion[]
  contract       Contract?
  chatRoom       ChatRoom?
  files          File[]

  @@unique([projectId, creatorId])
  @@index([creatorId, createdAt])
  @@index([projectId, status])
  @@map("work_requests")
}

// 인앱 알림 (ERD v0.6 notifications). (recipient_user_id, event_key) UNIQUE로 같은 사건의 중복 알림을 막는다.
model Notification {
  id              BigInt    @id @default(autoincrement())
  recipientUserId BigInt    @map("recipient_user_id")
  workRequestId   BigInt?   @map("work_request_id")
  projectId       BigInt?   @map("project_id")
  eventKey        String    @map("event_key")
  eventType       String    @map("event_type")
  title           String
  body            String
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient   User         @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  workRequest WorkRequest? @relation(fields: [workRequestId], references: [id], onDelete: Restrict)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([recipientUserId, eventKey])
  @@index([recipientUserId, createdAt])
  @@map("notifications")
}

model ProjectBookmark {
  userId    BigInt   @map("user_id")
  projectId BigInt   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@id([userId, projectId])
  @@index([projectId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("project_bookmarks")
}

// ─── 최종 조건서·서명·계약 (결정 기록 13장) ─────────────────────
// 조건서는 협의 중인 요청(work_requests) 하나에 붙는다. 값은 처음 저장한 뒤 바꾸지 않고, 바꿀 때는 새 버전을 만든다.
// 상태 허용 값은 마이그레이션 CHECK와 @kemi/shared TERMS_VERSION_STATUSES가 같다.

model TermsVersion {
  id                 BigInt    @id @default(autoincrement())
  workRequestId      BigInt    @map("work_request_id")
  versionNo          Int       @map("version_no")
  status             String    @default("DRAFT")
  amountKrw          BigInt?   @map("amount_krw")
  specification      String?
  scope              String?
  materials          String?
  deadline           String?
  revisions          String?
  usageRights        String?   @map("usage_rights")
  cancellation       String?
  // 첫 저장 때 고정한 참조 사본(프로젝트 공개 필드, 그 요청의 지원 내용). 다음 버전에 그대로 복사한다.
  referenceSnapshot  Json      @map("reference_snapshot")
  termsHash          String    @map("terms_hash")
  authorId           BigInt    @map("author_id")
  commandId          String    @map("command_id") @db.Uuid
  signingRequestedBy BigInt?   @map("signing_requested_by")
  signingRequestedAt DateTime? @map("signing_requested_at") @db.Timestamptz(3)
  signingExpiresAt   DateTime? @map("signing_expires_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workRequest      WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Restrict)
  author           User        @relation("TermsVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  signingRequester User?       @relation("TermsVersionSigningRequester", fields: [signingRequestedBy], references: [id], onDelete: Restrict)
  signatures       Signature[]
  contract         Contract?

  @@unique([workRequestId, versionNo])
  @@unique([workRequestId, commandId])
  @@map("terms_versions")
}

model Signature {
  id             BigInt   @id @default(autoincrement())
  termsVersionId BigInt   @map("terms_version_id")
  userId         BigInt   @map("user_id")
  signerName     String   @map("signer_name")
  termsHash      String   @map("terms_hash")
  signedAt       DateTime @default(now()) @map("signed_at") @db.Timestamptz(3)

  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([termsVersionId, userId])
  @@map("signatures")
}

// 같은 버전의 두 번째 서명 때 처음 만든다. project_id UNIQUE로 공고당 계약은 하나다(결정 기록 2장).
model Contract {
  id             BigInt   @id @default(autoincrement())
  workRequestId  BigInt   @unique @map("work_request_id")
  projectId      BigInt?  @unique @map("project_id")
  termsVersionId BigInt   @unique @map("terms_version_id")
  clientId       BigInt   @map("client_id")
  creatorId      BigInt   @map("creator_id")
  amountKrw      BigInt   @map("amount_krw")
  // 계약 당시 모의 정산 수수료율(만분율). 1000 = 10%
  feeRateBps     Int      @default(1000) @map("fee_rate_bps")
  termsHash      String   @map("terms_hash")
  status         String   @default("SIGNED")
  signedAt       DateTime @map("signed_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workRequest  WorkRequest  @relation(fields: [workRequestId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict)
  client       User         @relation("ContractClient", fields: [clientId], references: [id], onDelete: Restrict)
  creator      User         @relation("ContractCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  payments     Payment[]
  production   Production?
  settlement   Settlement?
  reviews      Review[]

  @@map("contracts")
}

// ─── 테스트 결제 (PAY-01·02, Toss Sandbox) ─────────────────────
// 계약 전액을 결제하는 주문. 실패·취소된 주문도 지우지 않고 이력으로 남긴다.
// 계약당 진행 중이거나 성공한 주문(READY·UNKNOWN·SUCCEEDED)은 하나뿐이다(부분 UNIQUE, 마이그레이션).
model Payment {
  id             BigInt    @id @default(autoincrement())
  contractId     BigInt    @map("contract_id")
  // Toss orderId. 의뢰인 화면이 만든 요청 식별자(UUID)를 그대로 쓴다.
  orderId        String    @unique @map("order_id")
  amountKrw      BigInt    @map("amount_krw")
  orderName      String    @map("order_name")
  status         String    @default("READY")
  paymentKey     String?   @unique @map("payment_key")
  method         String?
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(3)
  failureCode    String?   @map("failure_code")
  failureMessage String?   @map("failure_message")
  createdBy      BigInt    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  creator  User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([contractId, createdAt])
  @@map("payments")
}

// ─── 요청별 대화 (CHAT-01~05, WORK-04) ─────────────────────────
// 요청 하나에 방 하나. 협의 요청 때 만들고, 계약 뒤에도 같은 방을 쓴다.
// 읽기 전용 여부는 요청 상태(거절·철회·미선정)로 판단한다(저장하지 않음).
model ChatRoom {
  id            BigInt   @id @default(autoincrement())
  workRequestId BigInt   @unique @map("work_request_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workRequest WorkRequest   @relation(fields: [workRequestId], references: [id], onDelete: Restrict)
  messages    ChatMessage[]
  reads       ChatRead[]

  @@map("chat_rooms")
}

model ChatMessage {
  id        BigInt   @id @default(autoincrement())
  roomId    BigInt   @map("room_id")
  kind      String   @default("USER")
  // SYSTEM 메시지는 보낸 사람이 없다.
  senderId  BigInt?  @map("sender_id")
  body      String
  // USER: 화면이 만든 식별자(재전송 중복 방지). SYSTEM: 사건 키(같은 사건 한 번).
  dedupeKey String   @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  room        ChatRoom         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  sender      User?            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments ChatAttachment[]

  @@unique([roomId, dedupeKey])
  @@index([roomId, id])
  @@map("chat_messages")
}

model ChatRead {
  roomId            BigInt   @map("room_id")
  userId            BigInt   @map("user_id")
  lastReadMessageId BigInt   @map("last_read_message_id")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
  @@map("chat_reads")
}

// ─── 파일 (FILE-01, 결정 기록 4장) ─────────────────────────────
// 바이트는 Supabase Storage 비공개 버킷에 있고, 여기에는 소유자·쓰임·확인 상태만 둔다.
// 거래 파일(채팅 첨부·자료·납품물·수정 첨부)은 work_request_id가 있고 그 요청의 당사자만 볼 수 있다.
model File {
  id              BigInt    @id @default(autoincrement())
  ownerId         BigInt    @map("owner_id")
  purpose         String
  mimeType        String    @map("mime_type")
  fileName        String    @map("file_name")
  sizeBytes       BigInt    @map("size_bytes")
  storagePath     String    @unique @map("storage_path")
  status          String    @default("PENDING")
  rejectionReason String?   @map("rejection_reason")
  workRequestId   BigInt?   @map("work_request_id")
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  workRequest      WorkRequest?         @relation(fields: [workRequestId], references: [id], onDelete: Restrict)
  chatAttachments  ChatAttachment[]
  materials        ProductionMaterial[]
  deliverableFiles DeliverableFile[]
  revisionFiles    RevisionFile[]
  portfolioVideos  Portfolio[]          @relation("PortfolioVideo")
  portfolioThumbs  Portfolio[]          @relation("PortfolioThumbnail")

  @@index([ownerId, createdAt])
  @@index([workRequestId])
  @@map("files")
}

model ChatAttachment {
  messageId BigInt @map("message_id")
  fileId    BigInt @map("file_id")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  file    File        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([messageId, fileId])
  @@map("chat_attachments")
}

// ─── 제작 준비·시작·납기 (READY-01·02, WORK-01·02) ─────────────
// 계약 하나에 제작 하나. 계약 체결 때 PREPARING으로 만들고, 조건이 갖춰지면 크리에이터가 시작한다.
model Production {
  contractId    BigInt    @id @map("contract_id")
  status        String    @default("PREPARING")
  workingDays   Int       @map("working_days")
  // 일반 수정 회차(조건서 수정 횟수에서 읽음, [제안, D11])
  revisionLimit Int       @default(2) @map("revision_limit")
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  // 실제 마감일(KST 날짜). 시작할 때 한 번 계산하고, 승인된 납기 변경으로만 바뀐다.
  dueDate       DateTime? @map("due_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract         Contract             @relation(fields: [contractId], references: [id], onDelete: Restrict)
  materials        ProductionMaterial[]
  deadlineChanges  DeadlineChange[]
  deliverables     Deliverable[]
  revisionRequests RevisionRequest[]

  @@map("productions")
}

model ProductionMaterial {
  id                 BigInt    @id @default(autoincrement())
  contractId         BigInt    @map("contract_id")
  kind               String
  status             String    @default("SUBMITTED")
  fileId             BigInt?   @map("file_id")
  carrier            String?
  trackingNumber     String?   @map("tracking_number")
  note               String?
  issueNote          String?   @map("issue_note")
  replacesMaterialId BigInt?   @unique @map("replaces_material_id")
  submittedBy        BigInt    @map("submitted_by")
  // 화면이 만든 요청 식별자. 응답을 못 받고 다시 보내도 자료가 한 번만 생긴다.
  commandId          String    @unique @map("command_id") @db.Uuid
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  production  Production          @relation(fields: [contractId], references: [contractId], onDelete: Restrict)
  file        File?               @relation(fields: [fileId], references: [id], onDelete: Restrict)
  submitter   User                @relation(fields: [submittedBy], references: [id], onDelete: Restrict)
  replaces    ProductionMaterial? @relation("MaterialReplacement", fields: [replacesMaterialId], references: [id], onDelete: Restrict)
  replacement ProductionMaterial? @relation("MaterialReplacement")

  @@index([contractId, createdAt])
  @@map("production_materials")
}

model DeadlineChange {
  id              BigInt    @id @default(autoincrement())
  contractId      BigInt    @map("contract_id")
  requestedBy     BigInt    @map("requested_by")
  previousDueDate DateTime  @map("previous_due_date") @db.Date
  newDueDate      DateTime  @map("new_due_date") @db.Date
  reason          String
  status          String    @default("PENDING")
  respondedBy     BigInt?   @map("responded_by")
  respondedAt     DateTime? @map("responded_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  production Production @relation(fields: [contractId], references: [contractId], onDelete: Restrict)
  requester  User       @relation("DeadlineChangeRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  responder  User?      @relation("DeadlineChangeResponder", fields: [respondedBy], references: [id], onDelete: Restrict)

  @@index([contractId, createdAt])
  @@map("deadline_changes")
}

// ─── 검토·수정·최종 수령 (DEL-01~05, REV-01~02) ────────────────
// 납품 버전. 파일 업로드와 별개로 크리에이터가 정식 제출한 것만 버전이 된다. 계약마다 1부터 번호를 매긴다.
model Deliverable {
  id                        BigInt    @id @default(autoincrement())
  contractId                BigInt    @map("contract_id")
  versionNo                 Int       @map("version_no")
  kind                      String
  status                    String    @default("SUBMITTED")
  note                      String?
  // 이 버전으로 끝난 수정 요청(수정본). 요청 하나에 수정본 하나.
  resolvesRevisionRequestId BigInt?   @unique @map("resolves_revision_request_id")
  commandId                 String    @unique @map("command_id") @db.Uuid
  submittedBy               BigInt    @map("submitted_by")
  approvedAt                DateTime? @map("approved_at") @db.Timestamptz(3)
  receivedAt                DateTime? @map("received_at") @db.Timestamptz(3)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  production       Production        @relation(fields: [contractId], references: [contractId], onDelete: Restrict)
  submitter        User              @relation("DeliverableSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  resolves         RevisionRequest?  @relation("RevisionResolution", fields: [resolvesRevisionRequestId], references: [id], onDelete: Restrict)
  files            DeliverableFile[]
  revisionRequests RevisionRequest[] @relation("RevisionTarget")

  @@unique([contractId, versionNo])
  @@map("deliverables")
}

model DeliverableFile {
  deliverableId BigInt @map("deliverable_id")
  fileId        BigInt @map("file_id")

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Restrict)
  file        File        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([deliverableId, fileId])
  @@map("deliverable_files")
}

// 수정 요청. 대상 버전과 연결하고, 수정본이 제출되면 RESOLVED가 된다(일반 회차는 그때 한 번 차감).
model RevisionRequest {
  id            BigInt    @id @default(autoincrement())
  contractId    BigInt    @map("contract_id")
  deliverableId BigInt    @map("deliverable_id")
  type          String
  status        String    @default("OPEN")
  // 체크리스트 [{ position?, problem, desired }]
  items         Json
  note          String?
  commandId     String    @unique @map("command_id") @db.Uuid
  requestedBy   BigInt    @map("requested_by")
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  production Production     @relation(fields: [contractId], references: [contractId], onDelete: Restrict)
  target     Deliverable    @relation("RevisionTarget", fields: [deliverableId], references: [id], onDelete: Restrict)
  requester  User           @relation("RevisionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  resolution Deliverable?   @relation("RevisionResolution")
  files      RevisionFile[]

  @@index([contractId, createdAt])
  @@map("revision_requests")
}

model RevisionFile {
  revisionRequestId BigInt @map("revision_request_id")
  fileId            BigInt @map("file_id")

  revisionRequest RevisionRequest @relation(fields: [revisionRequestId], references: [id], onDelete: Restrict)
  file            File            @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([revisionRequestId, fileId])
  @@map("revision_files")
}

// ─── 모의 정산 (SETTLE-01) ────────────────────────────────────
// 결제 완료·최종 수령·보류 없음일 때 계약당 한 번. 실제 송금이 아니다.
model Settlement {
  contractId BigInt   @id @map("contract_id")
  status     String   @default("SIMULATED")
  grossKrw   BigInt   @map("gross_krw")
  feeRateBps Int      @map("fee_rate_bps")
  feeKrw     BigInt   @map("fee_krw")
  payoutKrw  BigInt   @map("payout_krw")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@map("settlements")
}

// ─── 리뷰 (REVIEW-01) ─────────────────────────────────────────
// 정상 완료 거래의 당사자가 상대방을 한 번씩 평가한다.
model Review {
  id         BigInt   @id @default(autoincrement())
  contractId BigInt   @map("contract_id")
  reviewerId BigInt   @map("reviewer_id")
  revieweeId BigInt   @map("reviewee_id")
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reviewer User     @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee User     @relation("ReviewSubject", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([contractId, reviewerId])
  @@index([revieweeId, createdAt])
  @@map("reviews")
}

// ─── 제작 패키지·작업물 (PACK-01~03, PORT-01~02) ─────────────────
// 초안은 제목만 있어도 저장한다. 공개(PUBLIC)하려면 필수 항목이 모두 있어야 한다(CHECK, 마이그레이션).
// 크리에이터당 대표 패키지는 하나뿐이고 공개 상태여야 한다(부분 UNIQUE).
model ServicePackage {
  id               BigInt   @id @default(autoincrement())
  creatorId        BigInt   @map("creator_id")
  title            String   @db.VarChar(100)
  description      String?
  purpose          String?
  priceKrw         BigInt?  @map("price_krw")
  deliveryDays     Int?     @map("delivery_days")
  revisionCount    Int?     @map("revision_count")
  includes         String[] @default([])
  status           String   @default("DRAFT")
  isRepresentative Boolean  @default(false) @map("is_representative")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  portfolios   Portfolio[]
  workRequests WorkRequest[]

  @@index([creatorId, createdAt])
  @@map("service_packages")
}

model Portfolio {
  id              BigInt    @id @default(autoincrement())
  creatorId       BigInt    @map("creator_id")
  title           String    @db.VarChar(100)
  description     String?
  purpose         String?
  styles          String[]  @default([])
  roles           String[]  @default([])
  source          String    @default("OWN_WORK")
  clientConsent   Boolean   @default(false) @map("client_consent")
  videoFileId     BigInt?   @map("video_file_id")
  thumbnailFileId BigInt?   @map("thumbnail_file_id")
  packageId       BigInt?   @map("package_id")
  status          String    @default("DRAFT")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator   User            @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  video     File?           @relation("PortfolioVideo", fields: [videoFileId], references: [id], onDelete: Restrict)
  thumbnail File?           @relation("PortfolioThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict)
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([creatorId, createdAt])
  @@index([status, publishedAt])
  @@map("portfolios")
}

// ─── 공고 임시 저장 (CAMP-01·02) ────────────────────────────────
// 작성 중인 값을 그대로 저장한다. 공개하면 검사를 통과한 값으로 projects 행을 만들고 연결한다.
model ProjectDraft {
  id                 BigInt   @id @default(autoincrement())
  clientId           BigInt   @map("client_id")
  values             Json
  recruitmentDays    Int      @default(7) @map("recruitment_days")
  publishedProjectId BigInt?  @unique @map("published_project_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  client           User     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  publishedProject Project? @relation(fields: [publishedProjectId], references: [id], onDelete: Restrict)

  @@index([clientId, updatedAt])
  @@map("project_drafts")
}

// ─── AI 단가 분석 보고서 (AI-01·02) ─────────────────────────────
// 분석마다 입력·검증된 결과를 남긴다. 예산 반영은 의뢰인이 명시적으로 할 때만(applied_*).
model AiReport {
  id                 BigInt    @id @default(autoincrement())
  userId             BigInt    @map("user_id")
  model              String
  input              Json
  output             Json
  estimatedBudgetKrw BigInt    @map("estimated_budget_krw")
  appliedAt          DateTime? @map("applied_at") @db.Timestamptz(3)
  appliedBudgetKrw   BigInt?   @map("applied_budget_krw")
  appliedDraftId     BigInt?   @map("applied_draft_id")
  appliedProjectId   BigInt?   @map("applied_project_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("ai_reports")
}
