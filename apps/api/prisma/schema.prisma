// KEMI 백엔드 Prisma 스키마
// 테이블은 ERD v0.6과 docs/decisions/2026-10-19-backend-setup.md 결정을 기준으로
// 기능 단위 PR에서 순서대로 추가한다. 변경 명세: docs/erd/erd-v0.6-changes.md
//
// 상태값 규칙: PostgreSQL enum 대신 text + CHECK 제약을 사용하고,
// 허용 값은 @kemi/shared의 Zod enum과 같은 목록으로 관리한다.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── 회원·인증 ────────────────────────────────────────────────
// CHECK 제약(역할·상태·제공자·폐기 사유·이메일 정규화 등)은 마이그레이션 SQL에 직접 작성했다.
// 회원은 삭제하지 않고 상태로 관리하므로 FK는 삭제를 막는다(Restrict).

model User {
  id           BigInt   @id @default(autoincrement())
  // 이메일 로그인 주소. 소셜 전용 가입자는 NULL. 정규화(trim + 소문자)한 값만 저장한다.
  email        String?  @unique
  // bcrypt 해시. 소셜 전용 계정은 NULL이며 이메일·비밀번호 로그인을 할 수 없다.
  passwordHash String?  @map("password_hash")
  name         String   @db.VarChar(20)
  role         String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities     AuthIdentity[]
  sessions       AuthSession[]
  clientProfile  ClientProfile?
  creatorProfile CreatorProfile?

  @@map("users")
}

model AuthIdentity {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  // 제공자가 알려준 이메일(선택). users.email과 자동으로 병합하지 않는다.
  providerEmail  String?  @map("provider_email")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

// 로그인 세션 1건 = Refresh 토큰 계열 1개. id는 Access 토큰의 sid이며 회전해도 바뀌지 않는다.
model AuthSession {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  // 로그인 시각 + 7일. 회전해도 연장하지 않는다.
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user          User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens AuthRefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

// 개별 Refresh 토큰. 원문은 저장하지 않고 SHA-256 해시만 둔다. 회전 이력 보존을 위해 삭제하지 않는다.
model AuthRefreshToken {
  id           BigInt    @id @default(autoincrement())
  sessionId    BigInt    @map("session_id")
  tokenHash    String    @unique @map("token_hash")
  // 회전에 사용된 시각. NULL이면 아직 쓸 수 있다.
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById BigInt?   @unique @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session    AuthSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedBy AuthRefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   AuthRefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@map("auth_refresh_tokens")
}

// ─── 역할별 프로필 ────────────────────────────────────────────
// 회원 1명당 역할에 맞는 프로필 하나. 역할 일치는 서버에서 검사한다.
// 선택값(분야·스타일·역할·공개 상태)의 허용 목록은 마이그레이션 CHECK와 @kemi/shared가 같게 유지한다.

// 의뢰인 프로필 (PROFILE-01). 브랜드 정보는 모두 선택이다. 로고는 파일 기능에서 추가한다.
model ClientProfile {
  userId       BigInt   @id @map("user_id")
  brandName    String?  @map("brand_name")
  introduction String?
  industry     String?
  websiteUrl   String?  @map("website_url")
  socialUrl    String?  @map("social_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("client_profiles")
}

// 크리에이터 프로필 (PROFILE-02). 저장만으로 공개하지 않는다(service_status 기본 DRAFT).
model CreatorProfile {
  userId          BigInt    @id @map("user_id")
  introduction    String?
  niche           String?
  contentStyles   String[]  @default([]) @map("content_styles")
  productionRoles String[]  @default([]) @map("production_roles")
  workMethod      String?   @map("work_method")
  serviceStatus   String    @default("DRAFT") @map("service_status")
  isAvailable     Boolean   @default(false) @map("is_available")
  availableFrom   DateTime? @map("available_from") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  packages ServicePackage[]

  @@map("creator_profiles")
}

// 서비스 패키지 (PACK-01~03). 삭제는 deleted_at으로 표시만 한다(요청·계약이 참조할 수 있어 행을 지우지 않는다).
// 대표 하나·대표는 공개·삭제 시 비공개 같은 규칙은 마이그레이션 SQL의 CHECK·부분 UNIQUE 인덱스로 강제한다.
model ServicePackage {
  id                BigInt    @id @default(autoincrement())
  creatorId         BigInt    @map("creator_id")
  title             String
  description       String
  basePrice         BigInt    @map("base_price")
  currency          String    @default("KRW") @db.Char(3)
  specification     Json
  includedScope     String    @map("included_scope")
  excludedScope     String    @map("excluded_scope")
  requiredMaterials Json      @map("required_materials")
  deliveryDays      Int       @map("delivery_days")
  revisionLimit     Int       @map("revision_limit")
  revisionScope     String    @map("revision_scope")
  sourceDelivery    Json      @map("source_delivery")
  usageTerms        Json      @map("usage_terms")
  isPublic          Boolean   @default(false) @map("is_public")
  isRepresentative  Boolean   @default(false) @map("is_representative")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Restrict)

  @@index([creatorId])
  @@map("service_packages")
}
